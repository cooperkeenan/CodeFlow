# Copy to .env and fill in. .env is gitignored and is NOT hot-reloaded —
# restart the services after editing it.

# LLM (temperature 0; omit to fall back to the deterministic heuristic judge)
ANTHROPIC_API_KEY=sk-ant-...

# Persistence
DATABASE_URL=postgresql://user:password@host/dbname

# GitHub OAuth (dashboard repo picker + "link GitHub")
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Analyse a repo from disk instead of GitHub
LOCAL_REPO=true
LOCAL_REPO_PATH=/absolute/path/to/a/python/repo

# local -> agent URLs point at localhost; anything else -> the Railway URLs below
ENVIRONMENT=local
PROFILER_AGENT_URL=http://localhost:8002
TRACER_AGENT_URL=http://localhost:8003
RENDER_AGENT_URL=http://localhost:8004
EXPLAIN_AGENT_URL=http://localhost:8007

# Frontend origin allowed by CORS
CORS_ORIGIN=http://localhost:5173

# Max archive size accepted by POST /ci/analyse (the GitHub Action upload)
CI_MAX_UPLOAD_MB=50
