{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "API Gateway",
            "type": "shell",
            "command": "${workspaceFolder}/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000 --reload",
            "windows": {
                "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe run.py"
            },
            "options": {
                "cwd": "${workspaceFolder}/api",
                "env": {
                    "PYTHONPATH": "${workspaceFolder}"
                }
            },
            "icon": {
                "id": "plug",
                "color": "terminal.ansiBlue"
            },
            "isBackground": true
        },
        {
            "label": "Profiler Agent",
            "type": "shell",
            "command": "${workspaceFolder}/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8002 --reload",
            "windows": {
                "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe -m uvicorn main:app --host 127.0.0.1 --port 8002 --reload"
            },
            "options": {
                "cwd": "${workspaceFolder}/agents/profiler_agent",
                "env": {
                    "PYTHONPATH": "${workspaceFolder}"
                }
            },
            "icon": {
                "id": "search",
                "color": "terminal.ansiGreen"
            },
            "isBackground": true
        },
        {
