{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "API Gateway",
            "type": "shell",
            "command": "${workspaceFolder}/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000 --reload",
            "windows": {
                "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe run.py"
            },
            "options": {
                "cwd": "${workspaceFolder}/api",
                "env": {
                    "PYTHONPATH": "${workspaceFolder}"
                }
            },
            "icon": {
                "id": "plug",
                "color": "terminal.ansiBlue"
            },
            "isBackground": true
        },
        {
            "label": "Profiler Agent",
            "type": "shell",
            "command": "${workspaceFolder}/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8002 --reload",
            "windows": {
                "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe -m uvicorn main:app --host 127.0.0.1 --port 8002 --reload"
            },
            "options": {
                "cwd": "${workspaceFolder}/agents/profiler_agent",
                "env": {
                    "PYTHONPATH": "${workspaceFolder}"
                }
            },
            "icon": {
                "id": "search",
                "color": "terminal.ansiGreen"
            },
            "isBackground": true
        },
        {
            "label": "Tracer Agent",
            "type": "shell",
            "command": "${workspaceFolder}/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8003 --reload",
            "windows": {
                "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe -m uvicorn main:app --host 127.0.0.1 --port 8003 --reload"
            },
            "options": {
                "cwd": "${workspaceFolder}/agents/tracer_agent",
                "env": {
                    "PYTHONPATH": "${workspaceFolder}"
                }
            },
            "icon": {
                "id": "git-branch",
                "color": "terminal.ansiYellow"
            },
            "isBackground": true
        },
        {
            "label": "Render Agent",
            "type": "shell",
            "command": "${workspaceFolder}/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8004 --reload",
            "windows": {
                "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe -m uvicorn main:app --host 127.0.0.1 --port 8004 --reload"
            },
            "options": {
                "cwd": "${workspaceFolder}/agents/render_agent",
                "env": {
                    "PYTHONPATH": "${workspaceFolder}"
                }
            },
            "icon": {
                "id": "graph",
                "color": "terminal.ansiMagenta"
            },
            "isBackground": true
        },
        {
            "label": "Layout Agent",
            "type": "shell",
            "command": "${workspaceFolder}/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8006 --reload",
            "windows": {
                "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe -m uvicorn main:app --host 127.0.0.1 --port 8006 --reload"
            },
            "options": {
                "cwd": "${workspaceFolder}/agents/layout_agent",
                "env": {
                    "PYTHONPATH": "${workspaceFolder}"
                }
            },
            "icon": {
                "id": "layout",
                "color": "terminal.ansiBlue"
            },
            "isBackground": true
        },
        {
            "label": "Frontend",
            "type": "shell",
            "command": "npm run dev",
            "options": {
                "cwd": "${workspaceFolder}/frontend"
            },
            "icon": {
                "id": "browser",
                "color": "terminal.ansiCyan"
            },
            "isBackground": true
        },
        {
            "label": "CodeFlow: All Services",
            "dependsOn": [
                "API Gateway",
                "Profiler Agent",
                "Tracer Agent",
                "Render Agent",
                "Layout Agent",
                "Frontend"
            ],
            "dependsOrder": "parallel",
            "icon": {
                "id": "rocket",
                "color": "terminal.ansiWhite"
            },
            "problemMatcher": []
        },
        {
            "label": "CodeFlow: Stop All",
            "type": "shell",
            "command": "for port in 8000 8002 8003 8004 8006 5173; do pids=$(lsof -ti :$port); if [ -n \"$pids\" ]; then echo \"$pids\" | xargs kill -9; echo \"Cleared port $port\"; else echo \"Port $port already free\"; fi; done",
            "windows": {
                "command": "foreach ($port in 8000,8002,8003,8004,8006,5173) { $procIds = Get-NetTCPConnection -LocalPort $port -ErrorAction SilentlyContinue | Select-Object -ExpandProperty OwningProcess -Unique; if ($procIds) { $procIds | ForEach-Object { Stop-Process -Id $_ -Force }; Write-Host \"Cleared port $port\" } else { Write-Host \"Port $port already free\" } }",
                "options": {
                    "shell": {
                        "executable": "powershell.exe",
                        "args": ["-NoProfile", "-Command"]
                    }
                }
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "icon": {
                "id": "stop-circle",
                "color": "terminal.ansiRed"
            }
        }
    ]
}