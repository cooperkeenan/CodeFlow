        "type": "database",
        "description": "Stores products, listings, and job status information."
      },
      {
        "name": "Docker",
        "type": "api",
        "description": "Used to containerize and run Selenium browser instances."
      },
      {
        "name": "Selenium WebDriver",
        "type": "api",
        "description": "Provides browser automation capabilities for marketplace scraping."
      },
      {
        "name": "IPRoyal Proxy Service",
